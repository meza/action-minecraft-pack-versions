{
  "name": "mc-pack-format-action",
  "version": "1.0.0",
  "private": true,
  "main": "src/index.ts",
  "scripts": {
    "build": "tsc --noEmit && esbuild src/index.ts --bundle --platform=node --target=node20 --format=cjs --minify --outfile=dist/index.js",
    "test": "pnpm run build && node --test test/release-time.test.mjs",
    "prepare": "pnpm run build",
    "run": "cross-env INPUT_commit_enabled=false INPUT_auto_merge=false INPUT_concurrency=1 tsx src/index.ts"
  },
  "dependencies": {
    "@actions/core": "3.0.0",
    "@actions/github": "9.0.0",
    "adm-zip": "0.6.0",
    "mustache": "4.2.0",
    "p-queue": "9.1.1"
  },
  "devDependencies": {
    "@types/adm-zip": "0.5.8",
    "@types/mustache": "4.2.6",
    "@types/node": "24.12.2",
    "esbuild": "0.28.1",
    "pnpm": "11.8.0",
    "tsx": "4.23.13",
    "typescript": "7.0.2"
  },
  "engines": {
    "node": "24"
  }
}
